# OpenAI-compatible API key
OPENAI_API_KEY=sk-your-key
# Optional: OpenAI-compatible base URL (leave unset for provider defaults)
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Optional: Model name to request for summarization
OPENAI_MODEL=qwen3-max

# Paths for Gmail OAuth credentials and token files
DIGEST_GMAIL_CREDENTIALS_PATH=credentials.json
DIGEST_GMAIL_TOKEN_PATH=token.json

# Output directory for generated digests
DIGEST_OUTPUT_DIR=artifacts/digests
# Location for cumulative summary CSV
DIGEST_SUMMARY_CSV_PATH=artifacts/summary.csv
